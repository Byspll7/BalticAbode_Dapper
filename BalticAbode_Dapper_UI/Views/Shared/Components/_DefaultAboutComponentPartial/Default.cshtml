@model List<ResultAboutDetailDto>

<section class="w3l-index3" id="about">
    <div class="midd-w3 pb-5">
        <div class="container pb-lg-5 pb-md-4 pb-2">
            <div class="row">
                <div class="col-lg-5 pr-lg-0">
                    <div class="w3l-left-img">
                    </div>
                </div>
                <div class="col-lg-7 pl-lg-0">
                    <div class="w3l-right-info">
                        <h6 class="title-small">@ViewBag.title</h6>
                        <h3 class="title-big">@ViewBag.subtitle</h3>
                        <p class="mt-4">
                            @ViewBag.desc1
                        </p>
                        <p class="mt-3">
                            @ViewBag.desc2
                        </p>
                        <ul class="w3l-right-book w3l-right-book-grid mt-md-5 mt-4">
                            @*Add Services With Model*@
                            <li><span class="fa fa-check" aria-hidden="true"></span>Property Listing</li>
                            <li><span class="fa fa-check" aria-hidden="true"></span>Real Estate Consulting</li>
                            <li><span class="fa fa-check" aria-hidden="true"></span>Legal Assistance</li>
                            <li><span class="fa fa-check" aria-hidden="true"></span>Mortgage Assistance</li>
                            <li><span class="fa fa-check" aria-hidden="true"></span>Rental Management</li>
                            <li><span class="fa fa-check" aria-hidden="true"></span>Market Analysis</li>
                        </ul>
                        <a href="#services" class="btn btn-style btn-primary mt-4">Discover our services</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>